# Frontend Environment Variables

# Local Development
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel/Production Deployment
# NEXT_PUBLIC_BACKEND_URL=https://your-backend-domain.vercel.app
# or
# NEXT_PUBLIC_BACKEND_URL=https://your-custom-api-domain.com

# The frontend will automatically use:
# 1. NEXT_PUBLIC_API_URL if set (usually for local dev)
# 2. NEXT_PUBLIC_BACKEND_URL if set (usually for production)
# 3. Relative paths if on production domain
# 4. Fallback to http://localhost:8000 for local dev
