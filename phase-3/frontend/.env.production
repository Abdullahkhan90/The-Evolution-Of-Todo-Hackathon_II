# Production environment variables for Vercel deployment

# IMPORTANT: In Vercel Dashboard, set these environment variables:
# 1. NEXT_PUBLIC_BACKEND_URL = Your Vercel Backend URL (e.g., https://todo-backend-prod.vercel.app)
# 2. NEXT_PUBLIC_API_URL = Same as NEXT_PUBLIC_BACKEND_URL

# These values will be injected by Vercel at build time
# DO NOT commit actual URLs here - use Vercel dashboard to set them
NEXT_PUBLIC_BACKEND_URL=https://your-backend-url.vercel.app
NEXT_PUBLIC_API_URL=https://your-backend-url.vercel.app

# Optional: Set to disable server-side rendering if needed
# DISABLE_STATIC_GENERATION=true
